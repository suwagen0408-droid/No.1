// This is your Prisma schema file for SQLite (sandbox demo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// 認証・ユーザー管理
// ============================================

enum UserRole {
  manufacturer
  facility
  admin
}

enum UserStatus {
  pending
  active
  suspended
  rejected
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  passwordHash String @map("password_hash")
  role      UserRole
  status    UserStatus @default(pending)
  
  emailVerifiedAt   DateTime? @map("email_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  failedLoginAttempts Int     @default(0) @map("failed_login_attempts")
  lockedUntil       DateTime? @map("locked_until")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  // Relations
  manufacturer          Manufacturer?
  facility              Facility?
  passwordResetTokens   PasswordResetToken[]
  stockLogsCreated      StockLog[]
  notificationsReceived Notification[]
  approvedManufacturers Manufacturer[]       @relation("ApprovedBy")
  approvedFacilities    Facility[]           @relation("ApprovedBy")
  approvedProducts      Product[]            @relation("ApprovedBy")
  approvedCampaigns     Campaign[]           @relation("ApprovedBy")
  approvedReviews       ProductReview[]      @relation("ApprovedBy")
  approvedFacilityCampaigns FacilityCampaign[] @relation("ApprovedBy")
  auditLogs             AuditLog[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("password_reset_tokens")
}

// ============================================
// メーカー管理
// ============================================

model Manufacturer {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  companyName          String    @map("company_name")
  companyNameKana      String?   @map("company_name_kana")
  representativeName   String?   @map("representative_name")
  postalCode           String?   @map("postal_code")
  address              String?
  phone                String?
  websiteUrl           String?   @map("website_url")
  businessLicenseNumber String?  @map("business_license_number")
  description          String?
  logoUrl              String?   @map("logo_url")
  
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  rejectionReason  String?   @map("rejection_reason")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver     User?      @relation("ApprovedBy", fields: [approvedBy], references: [id])
  products     Product[]
  campaigns    Campaign[]
  invoices     Invoice[]
  
  @@map("manufacturers")
}

// ============================================
// 施設管理
// ============================================

enum FacilityType {
  hotel
  ryokan
  onsen
  cafe
  restaurant
  gym
  salon
  other
}

model Facility {
  id               String       @id @default(uuid())
  userId           String       @unique @map("user_id")
  facilityName     String       @map("facility_name")
  facilityNameKana String?      @map("facility_name_kana")
  facilityType     FacilityType @map("facility_type")
  postalCode       String?      @map("postal_code")
  address          String?
  phone            String?
  websiteUrl       String?      @map("website_url")
  
  totalRooms        Int?  @map("total_rooms")
  totalBeds         Int?  @map("total_beds")
  avgDailyGuests    Int?  @map("avg_daily_guests")
  avgMonthlyGuests  Int?  @map("avg_monthly_guests")
  
  tags        String  @default("[]")
  
  description String?
  images      String    @default("[]")
  
  approvedAt      DateTime? @map("approved_at")
  approvedBy      String?   @map("approved_by")
  rejectionReason String?   @map("rejection_reason")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver          User?              @relation("ApprovedBy", fields: [approvedBy], references: [id])
  facilityCampaigns FacilityCampaign[]
  qrCodes           QrCode[]
  qrScanEvents      QrScanEvent[]
  clickEvents       ClickEvent[]
  purchaseEvents    PurchaseEvent[]
  productReviews    ProductReview[]
  productFeedback   ProductFeedback[]
  invoiceItems      InvoiceItem[]
  
  @@map("facilities")
}

// ============================================
// 商品管理（簡略版）
// ============================================

enum ProductCategory {
  shampoo
  conditioner
  body_soap
  face_wash
  lotion
  cream
  serum
  sunscreen
  toothbrush
  toothpaste
  drink
  food
  supplement
  amenity
  other
}

enum ProductStatus {
  draft
  pending
  approved
  rejected
  archived
}

model Product {
  id             String          @id @default(uuid())
  manufacturerId String          @map("manufacturer_id")
  
  name        String
  nameEn      String?         @map("name_en")
  category    ProductCategory
  
  tagline             String?
  shortDescription    String? @map("short_description")
  description         String?
  ingredients         String?
  usageInstructions   String? @map("usage_instructions")
  
  volume  String?
  size    String?
  janCode String? @map("jan_code")
  
  costPrice   Float @map("cost_price")
  retailPrice Float @map("retail_price")
  currency    String  @default("JPY")
  
  ecUrl      String  @map("ec_url")
  ecPlatform String? @map("ec_platform")
  
  mainImageUrl String? @map("main_image_url")
  
  status          ProductStatus @default(draft)
  approvedAt      DateTime?     @map("approved_at")
  approvedBy      String?       @map("approved_by")
  rejectionReason String?       @map("rejection_reason")
  
  metadata String @default("{}")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  manufacturer              Manufacturer              @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  approver                  User?                     @relation("ApprovedBy", fields: [approvedBy], references: [id])
  productImages             ProductImage[]
  campaignProducts          CampaignProduct[]
  facilityProductPlacements FacilityProductPlacement[]
  qrCodes                   QrCode[]
  qrScanEvents              QrScanEvent[]
  clickEvents               ClickEvent[]
  purchaseEvents            PurchaseEvent[]
  productReviews            ProductReview[]
  productFeedback           ProductFeedback[]
  
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  caption      String?
  createdAt    DateTime @default(now()) @map("created_at")
  
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_images")
}

// ============================================
// キャンペーン管理（簡略版）
// ============================================

enum CostModel {
  free
  cost_price
  discounted
}

enum ShippingCostCoveredBy {
  manufacturer
  facility
  split
}

enum CampaignStatus {
  draft
  pending
  approved
  active
  paused
  completed
  archived
}

model Campaign {
  id             String         @id @default(uuid())
  manufacturerId String         @map("manufacturer_id")
  
  name        String
  description String?
  
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  
  totalUnits          Int  @map("total_units")
  maxUnitsPerFacility Int? @map("max_units_per_facility")
  
  targetFacilityTypes String @default("[]") @map("target_facility_types")
  targetFacilityTags  String @default("[]") @map("target_facility_tags")
  minMonthlyGuests    Int? @map("min_monthly_guests")
  
  costModel            CostModel             @default(free) @map("cost_model")
  shippingCostCoveredBy ShippingCostCoveredBy @default(manufacturer) @map("shipping_cost_covered_by")
  
  status          CampaignStatus @default(draft)
  approvedAt      DateTime?      @map("approved_at")
  approvedBy      String?        @map("approved_by")
  rejectionReason String?        @map("rejection_reason")
  
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  manufacturer         Manufacturer         @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  approver             User?                @relation("ApprovedBy", fields: [approvedBy], references: [id])
  campaignProducts     CampaignProduct[]
  facilityCampaigns    FacilityCampaign[]
  qrCodes              QrCode[]
  qrScanEvents         QrScanEvent[]
  clickEvents          ClickEvent[]
  purchaseEvents       PurchaseEvent[]
  invoiceItems         InvoiceItem[]
  
  @@map("campaigns")
}

model CampaignProduct {
  id             String   @id @default(uuid())
  campaignId     String   @map("campaign_id")
  productId      String   @map("product_id")
  unitsAllocated Int      @map("units_allocated")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")
  
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([campaignId, productId])
  @@map("campaign_products")
}

// ============================================
// 施設×キャンペーン連携
// ============================================

enum FacilityCampaignStatus {
  pending
  approved
  rejected
  active
  completed
  cancelled
}

model FacilityCampaign {
  id                        String                  @id @default(uuid())
  facilityId                String                  @map("facility_id")
  campaignId                String                  @map("campaign_id")
  
  requestedUnits            Int     @map("requested_units")
  requestedMessage          String? @map("requested_message")
  plannedPlacementLocations String? @map("planned_placement_locations")
  estimatedMonthlyUsage     Int?    @map("estimated_monthly_usage")
  
  status          FacilityCampaignStatus @default(pending)
  approvedUnits   Int?                   @map("approved_units")
  approvedAt      DateTime?              @map("approved_at")
  approvedBy      String?                @map("approved_by")
  rejectionReason String?                @map("rejection_reason")
  
  shippedAt      DateTime? @map("shipped_at")
  trackingNumber String?   @map("tracking_number")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  facility                  Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  campaign                  Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approver                  User?                      @relation("ApprovedBy", fields: [approvedBy], references: [id])
  facilityProductPlacements FacilityProductPlacement[]
  
  @@unique([facilityId, campaignId])
  @@map("facility_campaigns")
}

// Remaining models simplified for SQLite compatibility...
// (StockLog, QrCode, Events, Reviews, Invoices, Notifications, AuditLog)

model FacilityProductPlacement {
  id                 String  @id @default(uuid())
  facilityCampaignId String  @map("facility_campaign_id")
  productId          String  @map("product_id")
  
  locationLabel String @map("location_label")
  
  initialUnits     Int @map("initial_units")
  currentUnits     Int @map("current_units")
  reorderThreshold Int @default(5) @map("reorder_threshold")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  facilityCampaign FacilityCampaign @relation(fields: [facilityCampaignId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLogs        StockLog[]
  qrCodes          QrCode[]
  qrScanEvents     QrScanEvent[]
  
  @@map("facility_product_placements")
}

model StockLog {
  id                          String   @id @default(uuid())
  facilityProductPlacementId  String   @map("facility_product_placement_id")
  
  changeType  String @map("change_type")
  quantity    Int
  
  beforeUnits Int    @map("before_units")
  afterUnits  Int    @map("after_units")
  
  note     String? 
  loggedBy String  @map("logged_by")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  facilityProductPlacement FacilityProductPlacement @relation(fields: [facilityProductPlacementId], references: [id], onDelete: Cascade)
  logger                   User                     @relation(fields: [loggedBy], references: [id])
  
  @@map("stock_logs")
}

model QrCode {
  id                         String    @id @default(uuid())
  
  productId                  String    @map("product_id")
  facilityId                 String    @map("facility_id")
  facilityProductPlacementId String    @map("facility_product_placement_id")
  campaignId                 String    @map("campaign_id")
  
  codeString String @unique @map("code_string")
  url        String
  
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")
  
  product                  Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility                 Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityProductPlacement FacilityProductPlacement @relation(fields: [facilityProductPlacementId], references: [id], onDelete: Cascade)
  campaign                 Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  qrScanEvents             QrScanEvent[]
  
  @@map("qr_codes")
}

model QrScanEvent {
  id                         String    @id @default(uuid())
  
  qrCodeId                   String    @map("qr_code_id")
  productId                  String    @map("product_id")
  facilityId                 String    @map("facility_id")
  facilityProductPlacementId String?   @map("facility_product_placement_id")
  campaignId                 String?   @map("campaign_id")
  
  userAgent   String? @map("user_agent")
  ipHash      String? @map("ip_hash")
  
  sessionId String? @map("session_id")
  
  scannedAt DateTime @default(now()) @map("scanned_at")
  
  qrCode                   QrCode                    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility                 Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityProductPlacement FacilityProductPlacement? @relation(fields: [facilityProductPlacementId], references: [id], onDelete: SetNull)
  campaign                 Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickEvents              ClickEvent[]
  productFeedback          ProductFeedback[]
  
  @@map("qr_scan_events")
}

model ClickEvent {
  id            String   @id @default(uuid())
  
  qrScanEventId String   @map("qr_scan_event_id")
  productId     String   @map("product_id")
  facilityId    String   @map("facility_id")
  campaignId    String?  @map("campaign_id")
  
  clickUrl  String  @map("click_url")
  sessionId String? @map("session_id")
  
  clickedAt DateTime @default(now()) @map("clicked_at")
  
  qrScanEvent    QrScanEvent      @relation(fields: [qrScanEventId], references: [id], onDelete: Cascade)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  purchaseEvents PurchaseEvent[]
  
  @@map("click_events")
}

model PurchaseEvent {
  id              String   @id @default(uuid())
  
  clickEventId   String?  @map("click_event_id")
  productId      String   @map("product_id")
  facilityId     String?  @map("facility_id")
  campaignId     String?  @map("campaign_id")
  
  externalOrderId String  @unique @map("external_order_id")
  amount          Float
  currency        String  @default("JPY")
  quantity        Int     @default(1)
  
  purchasedAt DateTime @map("purchased_at")
  receivedAt  DateTime @default(now()) @map("received_at")
  
  clickEvent ClickEvent? @relation(fields: [clickEventId], references: [id], onDelete: SetNull)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility   Facility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  @@map("purchase_events")
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  facilityId String?  @map("facility_id")
  
  rating  Int
  comment String?
  
  nickname String?
  email    String?
  
  status     String @default("pending")
  approvedAt DateTime?    @map("approved_at")
  approvedBy String?      @map("approved_by")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  approver User?     @relation("ApprovedBy", fields: [approvedBy], references: [id])
  
  @@map("product_reviews")
}

model ProductFeedback {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  facilityId    String?      @map("facility_id")
  qrScanEventId String?      @map("qr_scan_event_id")
  
  feedbackType String @map("feedback_type")
  sessionId    String? @map("session_id")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  facility    Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  qrScanEvent QrScanEvent? @relation(fields: [qrScanEventId], references: [id], onDelete: SetNull)
  
  @@map("product_feedback")
}

model Invoice {
  id                 String   @id @default(uuid())
  manufacturerId     String   @map("manufacturer_id")
  
  invoiceNumber      String   @unique @map("invoice_number")
  billingPeriodStart DateTime @map("billing_period_start")
  billingPeriodEnd   DateTime @map("billing_period_end")
  
  subtotal Float
  tax      Float @default(0)
  total    Float
  currency String  @default("JPY")
  
  status   String @default("draft")
  issuedAt DateTime?     @map("issued_at")
  dueDate  DateTime?     @map("due_date")
  paidAt   DateTime?     @map("paid_at")
  
  pdfUrl String? @map("pdf_url")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  manufacturer Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  
  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(uuid())
  invoiceId   String @map("invoice_id")
  
  itemType    String @map("item_type")
  description String
  
  campaignId String? @map("campaign_id")
  facilityId String? @map("facility_id")
  
  quantity  Int     @default(1)
  unitPrice Float @map("unit_price")
  amount    Float
  
  createdAt DateTime @default(now()) @map("created_at")
  
  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  
  @@map("invoice_items")
}

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  
  type    String
  title   String
  message String
  
  relatedResourceType String? @map("related_resource_type")
  relatedResourceId   String? @map("related_resource_id")
  
  readAt DateTime? @map("read_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  
  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")
  userRole  String?  @map("user_role")
  
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  
  oldValues String? @map("old_values")
  newValues String? @map("new_values")
  
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("audit_logs")
}
